  "components": [
    {
      "name": "Panel tools",
      "kind": "button",
      "refersTo": "tool",
      "description": "Leading legend/data toggles with compact pressed states.",
      "html": "<div class=\"ds-tools\" role=\"toolbar\" aria-label=\"Plot tools\"><button class=\"ds-tool\" aria-label=\"Toggle legend\" aria-pressed=\"true\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><rect x=\"1\" y=\"1\" width=\"14\" height=\"14\" rx=\"2\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.3\"/><path d=\"M3 1.5H6V14.5H3Q1.5 14.5 1.5 13V3Q1.5 1.5 3 1.5Z\" fill=\"currentColor\" transform=\"rotate(180 8 8)\"/></svg></button><button class=\"ds-tool\" aria-label=\"Toggle data panel\" aria-pressed=\"true\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><rect x=\"1\" y=\"1\" width=\"14\" height=\"14\" rx=\"2\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.3\"/><path d=\"M3 1.5H6V14.5H3Q1.5 14.5 1.5 13V3Q1.5 1.5 3 1.5Z\" fill=\"currentColor\"/></svg></button></div>",
      "css": ".ds-tools{display:flex;gap:2px;padding:3px 0;background:#fbfbfb;color:#363636}.ds-tool{display:inline-flex;align-items:center;justify-content:center;width:26px;height:26px;padding:0;border:0;border-radius:3px;background:none;cursor:pointer}.ds-tool[aria-pressed=\"true\"]{background:var(--active,#e9e9e9);color:#222}.ds-tool:hover{background:var(--hover,#f1f1ef)}.ds-tool:focus-visible{outline:2px solid #8a8a8a;outline-offset:1px;}"
    },
    {
      "name": "Coordinate entry and action",
      "kind": "input",
      "refersTo": "field",
      "description": "Manual coordinates and a compact neutral Add action.",
      "html": "<div class=\"ds-manual\"><label for=\"ds-coordinates\">Paste coordinates</label><textarea id=\"ds-coordinates\" placeholder=\"Sample,PC1,\u2026,PC25\" rows=\"3\"></textarea><button class=\"ds-add\">Add coordinates</button><span class=\"ds-hint\">Ctrl/\u2318 + Enter</span></div>",
      "css": ".ds-manual{font:11px Arial,Helvetica,sans-serif;color:#363636;width:280px}.ds-manual textarea{display:block;width:100%;min-height:86px;margin:5px 0 6px;padding:5px 7px;border:1px solid #d8d5ce;border-radius:3px;background:#fff;color:inherit;font:11px/1.5 Arial,Helvetica,sans-serif;resize:vertical}.ds-manual textarea::placeholder{color:#72716d}.ds-add{font:12px Arial,Helvetica,sans-serif;min-height:27px;padding:4px 8px;border:1px solid #d8d5ce;border-radius:3px;background:#fff;color:#363636;cursor:pointer}.ds-add:hover{background:var(--hover,#f1f1ef)}.ds-add:active{background:var(--active,#e9e9e9)}.ds-add:focus-visible,.ds-manual textarea:focus-visible{outline:2px solid #8a8a8a;outline-offset:1px;}.ds-hint{font-size:10.5px;color:var(--muted,#696969);margin-left:7px}"
    },
    {
      "name": "Population and individual chips",
      "kind": "chip",
      "refersTo": "population-chip",
      "description": "Wrapping population/individual chips with inline search.",
      "html": "<div class=\"ds-picker\"><span class=\"ds-chip\">Population A <button aria-label=\"Remove Population A\">\u00d7</button></span><span class=\"ds-chip ds-individual\">SYN001 <button aria-label=\"Remove SYN001\">\u00d7</button></span><input aria-label=\"Search populations or genetic IDs\" placeholder=\"Search populations or genetic IDs\u2026\"/></div>",
      "css": ".ds-picker{display:flex;flex-wrap:wrap;align-content:flex-start;align-items:center;gap:4px;width:280px;min-height:72px;padding:5px 7px;border:1px solid #d8d5ce;border-radius:3px;font:12px Arial,Helvetica,sans-serif;background:#fff}.ds-picker:focus-within{border-color:#4891ff;box-shadow:0 0 0 2px #e6f0ff}.ds-chip{display:inline-flex;align-items:center;gap:4px;padding:2px 4px 2px 5px;border:1px solid #adc9ff;border-radius:3px;background:#e4edff;color:#0055bf;font-size:11.5px;line-height:1.4}.ds-individual{color:#653b83;background:#f2eafa;border-color:#d0b5e4}.ds-chip button{border:0;background:none;color:inherit;padding:0;cursor:pointer;font:inherit}.ds-chip button:hover{background:var(--hover,#f1f1ef)}.ds-chip button:focus-visible{outline:2px solid #8a8a8a;outline-offset:1px;}.ds-picker input{flex:1 1 140px;min-width:100px;width:100%;padding:4px 0;border:0;background:none;font:12px Arial,Helvetica,sans-serif;color:#363636}.ds-picker input:focus-visible{outline:0}.ds-picker input::placeholder{color:#72716d}"
    },
    {
      "name": "Navigation rail",
      "kind": "nav",
      "refersTo": "rail",
      "description": "Thin dark rail with active PCA and planned disabled tools.",
      "html": "<nav class=\"ds-rail\" aria-label=\"Analysis tools\"><button class=\"ds-rail-button ds-current\" aria-label=\"Custom PCA\" aria-current=\"page\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M3 3v18h18\"/><circle cx=\"7.5\" cy=\"14.5\" r=\".5\"/><circle cx=\"11.5\" cy=\"9.5\" r=\".5\"/><circle cx=\"16.5\" cy=\"16.5\" r=\".5\"/><circle cx=\"18.5\" cy=\"7.5\" r=\".5\"/></svg></button><button class=\"ds-rail-button\" aria-label=\"Distances (planned)\" disabled><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M21.3 8.7a1 1 0 0 0 0-1.4l-4.6-4.6a1 1 0 0 0-1.4 0L2.7 15.3a1 1 0 0 0 0 1.4l4.6 4.6a1 1 0 0 0 1.4 0z\"/><path d=\"m7.5 10.5 2 2m1-5 2 2m1-5 2 2m-11 7 2 2\"/></svg></button></nav>",
      "css": ".ds-rail{width:32px;padding-top:5px;background:#292b2d}.ds-rail-button{display:flex;align-items:center;justify-content:center;width:32px;height:35px;padding:0;border:0;background:none;color:#bdc3ca;cursor:pointer}.ds-rail-button.ds-current{background:#414448;color:#fff}.ds-rail-button:hover:not(:disabled){background:#414448}.ds-rail-button:disabled{opacity:.55;cursor:default}.ds-rail-button:focus-visible{outline:2px solid #8a8a8a;outline-offset:1px;}"
    },
    {
      "name": "PCA legend",
      "kind": "custom",
      "refersTo": "legend",
      "description": "Compact row with shared mark, count and explicit eye control.",
      "html": "<section class=\"ds-legend\" aria-label=\"Legend\"><h2>Populations <span>1</span></h2><div class=\"ds-legend-row\"><button class=\"ds-legend-item\" title=\"Synthetic population\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 14 14\" aria-hidden=\"true\"><circle cx=\"7\" cy=\"7\" r=\"3.5\" fill=\"#1f77b4\" stroke=\"#124568\" stroke-width=\".8\" opacity=\".9\"/></svg><span class=\"ds-legend-name\">Synthetic population</span><span class=\"ds-legend-count\">24</span></button><button class=\"ds-eye\" aria-label=\"Hide Synthetic population\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0\"/><circle cx=\"12\" cy=\"12\" r=\"3\"/></svg></button></div></section>",
      "css": ".ds-legend{width:215px;border:1px solid #bcbcbc;border-radius:2px;background:#fcfcfc;color:#363636;font:12px Arial,Helvetica,sans-serif}.ds-legend h2{height:30px;margin:0;padding:0 9px;display:flex;align-items:center;gap:8px;font-size:11px;font-weight:600}.ds-legend h2 span{font-size:9px;font-weight:400;color:var(--muted,#696969)}.ds-legend-row{display:flex;align-items:center;min-height:28px;margin:0 4px 5px}.ds-legend-row:hover{background:#f0f0ed}.ds-legend-item{flex:1;min-width:0;display:flex;align-items:center;gap:6px;padding:5px 3px;border:0;background:none;color:inherit;cursor:pointer}.ds-legend-name{flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;text-align:left;font:11px Arial,Helvetica,sans-serif}.ds-legend-count{font:9px Arial,Helvetica,sans-serif;color:var(--muted,#696969)}.ds-eye{width:23px;height:23px;display:flex;align-items:center;justify-content:center;padding:0;border:0;background:none;color:#62615d;cursor:pointer}.ds-eye:hover,.ds-legend-item:hover{background:var(--hover,#f1f1ef)}.ds-eye:focus-visible,.ds-legend-item:focus-visible{outline:2px solid #8a8a8a;outline-offset:1px;}"
    }
  ],
  "narrative": {
    "northStar": "The compact academic G25 workspace",
    "overview": "The approved visual world follows the user's PCA_views, ArchaeoBase and G25 Manager applications. Dense neutral panels support one continuous white graph; familiar direct controls keep attention on samples and geometry. Admix_IRE supplies population search and blue/purple selection language.\n\nPCA_views governs Arial typography, outlined markers, solid categorical colors, Lucide tools and the compact legend. G25 Views remains an interaction reference for legend gestures and analysis cycles. This document supersedes the former replica identity.",
    "keyCharacteristics": [
      "One compact strip",
      "Resizable left panels and continuous chart",
      "Arial 12px UI and outlined 7px markers",
      "Admix-style search and dense metadata"
    ],
    "rules": [
      {
        "name": "The Data Color Rule",
        "body": "Reserve marker colors for plot identity; blue and purple distinguish selection scope.",
        "section": "colors"
      },
      {
        "name": "The Working Type Rule",
        "body": "Preserve compact Arial controls and readable ticks.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do preserve the compact strip and continuous graph.",
      "Do preserve scope, focus and matching legend marks."
    ],
    "donts": [
      "Don't restore Bootstrap, source SVG tools or the prior right panel.",
      "Don't add Run PCA, Settings, a native modebar, PC titles or frame lines."
    ]
  }
}
