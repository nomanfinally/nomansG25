      "css": ".ds-icon{font-family:Arial,Helvetica,sans-serif;font-size:12px;color:#30363d;display:inline-flex;align-items:center;justify-content:center;gap:6px;height:30px;padding:0 10px;border:1px solid var(--color-line,#d7dce1);border-radius:var(--radius-control,3px);background:#fff;cursor:pointer;width:30px;padding:0;border-color:transparent;background:transparent;color:#505b66;}.ds-icon:hover:not(:disabled){background:#f2f5f7;}.ds-icon:focus-visible{outline:2px solid var(--color-primary,#1764ac);outline-offset:2px;}.ds-icon:disabled{cursor:default;color:#747c85;background:#fafbfc;}@media(prefers-reduced-motion:no-preference){.ds-icon{transition:background-color 120ms ease-out,border-color 120ms ease-out;}}.ds-icon[aria-pressed=\"true\"]{background:var(--color-active,#e7f1fa);border-color:#c4d9ed;color:#155b9b;}.ds-icon:disabled{background:transparent;color:#7b838c;}"
