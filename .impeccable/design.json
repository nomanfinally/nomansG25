      "html": "<button type=\"button\" class=\"ds-primary\">Run PCA</button>",
      "css": ".ds-primary{font-family:Arial,Helvetica,sans-serif;font-size:12px;color:#30363d;display:inline-flex;align-items:center;justify-content:center;gap:6px;height:30px;padding:0 10px;border:1px solid var(--color-line,#d7dce1);border-radius:var(--radius-control,3px);background:#fff;cursor:pointer;border-color:var(--color-primary,#1764ac);color:var(--color-primary,#1764ac);}.ds-primary:hover:not(:disabled){background:#f2f5f7;}.ds-primary:focus-visible{outline:2px solid var(--color-primary,#1764ac);outline-offset:2px;}.ds-primary:disabled{cursor:default;color:#747c85;background:#fafbfc;}@media(prefers-reduced-motion:no-preference){.ds-primary{transition:background-color 120ms ease-out,border-color 120ms ease-out;}}.ds-primary:hover:not(:disabled){background:var(--color-primary-hover,#edf5fc);}.ds-primary:disabled{border-color:#b5c3d0;}"
    },
